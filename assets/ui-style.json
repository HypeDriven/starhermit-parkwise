    ".page": {
      "background": "$bg",
      "radius": 0
    },
    ".title-bg": {
      "background": {
        "type": "linear",
        "stops": [
          {
            "color": "#0b1220",
            "at": 0
          },
          {
            "color": "#121c33",
            "at": 0.55
          },
          {
            "color": "#1d2342",
            "at": 1
          }
        ]
      },
      "radius": 0
