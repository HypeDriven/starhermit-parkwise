# Journey stage 1 by keys after a blocked slide, an undo and a hint; the pause overlay; the results.
# viewport 1280x800@1
# Generated by tools/gen-plays.mjs from the rules' solver.
until 600 Daily challenge
frames 20
click =Journey
until 600 Moves 0 / par 3
frames 60
save journey-start
key ArrowUp 1
frames 5
expect That move is blocked
key ArrowRight 1
frames 5
key KeyU 1
frames 5
expect Moves 0 / par 3
key KeyH 1
frames 60
expect Hints used 1
save journey-hint
key Escape 1
until 120 Leave round
frames 10
save journey-pause
click =Resume
frames 10
click =red car at column 2, row 3 (target)
frames 5
key KeyN 1
frames 2
key KeyN 1
frames 2
key ArrowLeft 1
frames 3
key ArrowLeft 1
frames 3
key KeyN 1
frames 2
key ArrowDown 1
frames 3
key ArrowDown 1
frames 3
key KeyN 1
frames 2
key KeyN 1
frames 2
key KeyN 1
frames 2
key KeyN 1
frames 2
key ArrowRight 1
frames 3
key ArrowRight 1
frames 3
key ArrowRight 1
frames 3
until 300 Lot cleared!
frames 10
expect Hint penalty
expect Personal best
save journey-done
click =Next
until 300 Moves 0 / par
frames 10
expect Seed 703f
